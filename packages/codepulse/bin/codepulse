#!/usr/bin/env bash
# codepulse — CodePulse 统一编码时间上报 CLI（向 WakaTime 发送心跳）
#
# 设计目标：作为 CLI / 终端 / 未来其他采集源的统一上报入口，
# 复用 ~/.wakatime.cfg 的 api_key，与官方 WakaTime 编辑器插件同源同后端。
set -euo pipefail

API_URL="${WAKATIME_API_URL:-https://api.wakatime.com/api/v1}"
CONFIG="${WAKATIME_CONFIG:-$HOME/.wakatime.cfg}"
PLUGIN="${CODEPULSE_PLUGIN:-codepulse-cli/0.1.0}"
TIMEOUT="${CODEPULSE_TIMEOUT:-5}"
MODE="heartbeat"
YES=0
DRY=0

usage() {
  cat <<USAGE
用法:
  codepulse heartbeat [选项]    发送一条编码心跳到 WakaTime（默认命令）
  codepulse init-zsh [选项]     在 ~/.zshrc 中启用 CodePulse zsh 插件
  codepulse --help             显示帮助

heartbeat 选项:
  --project <name>   项目名（git root / 文件夹 basename，与编辑器心跳同源）
  --entity <str>     实体：命令字符串或文件路径（默认当前工作目录）
  --type <type>      实体类型: app|file|url|domain（默认 app）
  --category <cat>   活动类别，默认 coding
  --write            标记为写入动作（CLI 敲命令默认视为操作）
  --branch <name>    分支名
  --time <ts>        心跳 Unix 时间戳（默认当前时间）
  --config <path>    wakatime 配置文件（默认 ~/.wakatime.cfg）
  --api-url <url>    WakaTime API 基址（默认 https://api.wakatime.com/api/v1）
  --dry-run          仅打印将发送的请求，不真正发送

init-zsh 选项:
  --yes              跳过确认，直接写入 ~/.zshrc
  --dry-run          仅打印将写入的内容

通用:
  --help             显示帮助

环境变量:
  WAKATIME_API_URL / WAKATIME_CONFIG / WAKATIME_API_KEY / CODEPULSE_ROOT 可覆盖默认值。
USAGE
}

# ---------- 参数 ----------
PROJECT="" ENTITY="" TYPE="app" CATEGORY="coding" WRITE=0 BRANCH="" TIME=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    heartbeat) MODE="heartbeat"; shift ;;
    init-zsh|init) MODE="init-zsh"; shift ;;
    --project) PROJECT="${2:?--project 需要参数}"; shift 2 ;;
    --entity) ENTITY="${2:?--entity 需要参数}"; shift 2 ;;
    --type) TYPE="$2"; shift 2 ;;
    --category) CATEGORY="$2"; shift 2 ;;
    --write) WRITE=1; shift ;;
    --branch) BRANCH="${2:?--branch 需要参数}"; shift 2 ;;
    --time) TIME="$2"; shift 2 ;;
    --config) CONFIG="$2"; shift 2 ;;
    --api-url) API_URL="$2"; shift 2 ;;
    --yes|-y) YES=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "未知参数: $1" >&2; usage >&2; exit 1 ;;
  esac
done

# ---------- 工具函数 ----------
json_escape() {
  # 用 python3 做严格 JSON 字符串转义；无 python3 时退化为 sed 基础转义
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys; sys.stdout.write(json.dumps(sys.stdin.read()))'
  else
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\t/\\t/g' -e 's/\n/\\n/g' -e 's/\r/\\r/g'
  fi
}

detect_project() {
  local dir="$1" root
  root="$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null || true)"
  if [[ -n "$root" ]]; then
    printf '%s\n' "${root##*/}"
  else
    printf '%s\n' "${dir##*/}"
  fi
}

read_api_key() {
  if [[ -n "${WAKATIME_API_KEY:-}" ]]; then
    printf '%s\n' "$WAKATIME_API_KEY"
    return 0
  fi
  [[ -f "$CONFIG" ]] || return 1
  local key
  key="$(sed -nE 's/^[[:space:]]*api_key[[:space:]]*=[[:space:]]*(.+)/\1/p' "$CONFIG" | head -n1)"
  [[ -n "$key" ]] && printf '%s\n' "$key"
}

detect_pkg_root() {
  # 按优先级：CODEPULSE_ROOT > npm 全局包目录 > 脚本真实路径推断
  [[ -n "${CODEPULSE_ROOT:-}" ]] && { printf '%s\n' "$CODEPULSE_ROOT"; return; }
  local g
  g="$(npm root -g 2>/dev/null || true)"
  if [[ -n "$g" && -d "$g/@bwrong/codepulse" ]]; then
    printf '%s\n' "$g/@bwrong/codepulse"
    return
  fi
  local self real
  self="$(command -v codepulse 2>/dev/null || printf '%s' "$0")"
  real="$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$self" 2>/dev/null || printf '%s' "$self")"
  cd "$(dirname "$real")/.." && pwd
}

init_zsh() {
  local zshrc="${ZDOTDIR:-$HOME}/.zshrc"
  local pkg_root plugin line
  pkg_root="$(detect_pkg_root)"
  plugin="$pkg_root/shell/codepulse.zsh"
  if [[ ! -f "$plugin" ]]; then
    echo "codepulse: 未找到 zsh 插件 ${plugin}（可设置 CODEPULSE_ROOT 指定包根）" >&2
    exit 1
  fi
  line="source \"$plugin\""
  if [[ -f "$zshrc" ]] && grep -qF "codepulse.zsh" "$zshrc"; then
    echo "codepulse: $zshrc 已包含 codepulse 配置，跳过"
    return 0
  fi
  if [[ $DRY -eq 1 ]]; then
    echo "将向 $zshrc 追加以下内容："
    echo "  $line"
    return 0
  fi
  if [[ $YES -ne 1 ]]; then
    echo "将向 $zshrc 追加以下内容："
    echo "  $line"
    printf '确认添加？[y/N] '
    read -r ans || true
    [[ "$ans" =~ ^[yY] ]] || { echo "已取消"; return 1; }
  fi
  { printf '\n# CodePulse 终端编码时间采集\n%s\n' "$line"; } >> "$zshrc"
  echo "已写入 ${zshrc}。执行 'source ${zshrc}' 或重开终端生效。"
}

# ---------- init-zsh ----------
if [[ $MODE == "init-zsh" ]]; then
  init_zsh
  exit $?
fi

# ---------- heartbeat 主流程 ----------
api_key="$(read_api_key || true)"
if [[ -z "$api_key" ]]; then
  echo "codepulse: 未找到 WakaTime api_key（${CONFIG}）" >&2
  exit 1
fi

PROJECT="${PROJECT:-$(detect_project "$PWD")}"
ENTITY="${ENTITY:-$PWD}"
TIME="${TIME:-$(date +%s)}"
BRANCH="${BRANCH:-$(git -C "$PWD" branch --show-current 2>/dev/null || true)}"

entity_json="$(printf '%s' "$ENTITY" | json_escape)"
project_json="$(printf '%s' "$PROJECT" | json_escape)"
branch_json=""
if [[ -n "$BRANCH" ]]; then
  branch_json="$(printf '%s' "$BRANCH" | json_escape)"
fi

is_write="false"
if [[ $WRITE -eq 1 ]]; then is_write="true"; fi

payload="[{\"time\":${TIME},\"entity\":${entity_json},\"type\":\"${TYPE}\",\"project\":${project_json},\"category\":\"${CATEGORY}\",\"is_write\":${is_write}"
if [[ -n "$branch_json" ]]; then
  payload+=",\"branch\":${branch_json}"
fi
payload+="}]"

url="${API_URL%/}/users/current/heartbeats.bulk"

if [[ $DRY -eq 1 ]]; then
  echo "URL:  POST $url"
  echo "BODY: $payload"
  exit 0
fi

auth="$(printf '%s:' "$api_key" | base64 | tr -d '\n')"
resp_file="$(mktemp -t codepulse.XXXXXX)"
trap 'rm -f "$resp_file"' EXIT

http_code="$(curl -sS --max-time "$TIMEOUT" -o "$resp_file" -w '%{http_code}' \
  -X POST "$url" \
  -H "Authorization: Basic $auth" \
  -H "Content-Type: application/json" \
  -H "User-Agent: $PLUGIN" \
  -d "$payload")" || true

case "$http_code" in
  201|202) exit 0 ;;
  401) echo "codepulse: 401 鉴权失败，请检查 $CONFIG 中的 api_key" >&2 ;;
  429) echo "codepulse: 429 请求过于频繁，稍后自动重试" >&2 ;;
  "")  echo "codepulse: 网络请求失败" >&2 ;;
  *)   echo "codepulse: WakaTime 返回 $http_code" >&2
       sed 's/^/  /' "$resp_file" >&2 || true ;;
esac
exit 1
